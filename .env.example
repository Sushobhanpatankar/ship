# Get your free API key at https://aisstream.io (register, then copy the key)
AISSTREAM_API_KEY=your_key_here

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database path — on Railway set this to a path inside a mounted volume:
#   1. Create a volume in Railway and mount it at /data
#   2. Set DATABASE_PATH=/data/ship_tracking.db
# Locally leave unset (defaults to ship_tracking.db in the project root)
DATABASE_PATH=ship_tracking.db

# Tuning (optional — defaults shown)
POSITION_RETENTION_HOURS=48
SCRAPER_INTERVAL_SECONDS=1800
AGGREGATOR_INTERVAL_SECONDS=300
