# Get your free API key at https://aisstream.io (register, then copy the key)
AISSTREAM_API_KEY=your_key_here

# AIS data source alternatives (used by the fetcher/ package)
# AISHub — free, register at https://www.aishub.net/api to get a username
AISHUB_USERNAME=your_aishub_username
# VesselFinder — free tier, register at https://www.vesselfinder.com/api
VESSELFINDER_API_KEY=your_vesselfinder_key
# MarineTraffic — commercial, obtain at https://www.marinetraffic.com/en/p/api-services
MARINETRAFFIC_API_KEY=your_mt_api_key

# Google Gemini — for crude_avg_agent.py
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database path — on Railway set this to a path inside a mounted volume:
#   1. Create a volume in Railway and mount it at /data
#   2. Set DATABASE_PATH=/data/ship_tracking.db
# Locally leave unset (defaults to ship_tracking.db in the project root)
DATABASE_PATH=ship_tracking.db

# Tuning (optional — defaults shown)
POSITION_RETENTION_HOURS=48
SCRAPER_INTERVAL_SECONDS=1800
AGGREGATOR_INTERVAL_SECONDS=300
